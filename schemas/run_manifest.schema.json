{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:closed-loop-eval-lab:run-manifest:1",
  "title": "Run manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "kind",
    "status",
    "code_revision",
    "config_sha256",
    "data_sha256",
    "split_id",
    "seeds",
    "hardware",
    "backend",
    "command",
    "started_at",
    "exit_code",
    "artifacts",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "smoke",
        "pilot",
        "study",
        "benchmark",
        "failure_injection"
      ]
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "TIMED_OUT",
        "UNASSESSABLE"
      ]
    },
    "code_revision": {
      "type": "string"
    },
    "config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "data_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "split_id": {
      "type": "string"
    },
    "seeds": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "hardware": {
      "type": "object"
    },
    "backend": {
      "type": "string"
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "started_at": {
      "type": "string"
    },
    "exit_code": {
      "type": "integer"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
